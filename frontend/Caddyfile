:80 {
	encode zstd gzip

	handle /api/v1/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	handle /api/schema/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	handle /admin* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	handle /static/* {
		reverse_proxy {$BACKEND_UPSTREAM:backend:8000}
	}

	handle {
		root * /srv/frontend
		@device_page path_regexp device_page ^/devices/[0-9]+/?$
		rewrite @device_page /devices.html
		try_files {path} /index.html
		file_server
	}
}
