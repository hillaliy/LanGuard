:80 {
    encode zstd gzip

    handle /api/v1/* {
        reverse_proxy backend:8000
    }

    handle /api/schema/* {
        reverse_proxy backend:8000
    }

    handle /admin* {
        reverse_proxy backend:8000
    }

    handle /static/* {
        reverse_proxy backend:8000
    }

    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
